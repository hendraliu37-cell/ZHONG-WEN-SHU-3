# ZHONGWEN SHU — template kredensial.
# SALIN file ini jadi "acc.env" lalu isi nilainya.
# acc.env sudah di-.gitignore. JANGAN commit. JANGAN kirim ke LLM.
# Tutorial: docs/accounts-setup.md

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=            # boleh dipakai di client (Flutter)
SUPABASE_SERVICE_ROLE_KEY=    # SERVER ONLY (Edge Function) — rahasia

# --- Azure Speech (skoring pelafalan) — SERVER ONLY ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=          # contoh: southeastasia

# --- OpenCode Zen (DeepSeek, guru/chat) — SERVER ONLY ---
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=        # endpoint OpenAI-compatible
OPENCODE_ZEN_MODEL=           # id model DeepSeek free flash

# --- Resend (email konfirmasi) — SERVER ONLY ---
RESEND_API_KEY=
